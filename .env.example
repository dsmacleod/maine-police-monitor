# Copy to .env and fill in. .env is gitignored.

# Apify API token: https://console.apify.com/settings/integrations
# Uses the alfalfa/facebook-posts-scraper actor: $0.002 per post returned, empty checks free.
APIFY_TOKEN=

# Claude API key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Slack: the "Police Pages" bot (app A0C5XJRVB1T, defined in manifest.json).
# Bot token: https://api.slack.com/apps/A0C5XJRVB1T/oauth -> "Bot User OAuth Token" (xoxb-...)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=          # channel ID (C0...) or #name; public channels need no invite
# Or, instead of the bot, an incoming-webhook URL:
# SLACK_WEBHOOK_URL=

# Optional tuning (defaults shown):
# FIRST_LOOKBACK_HOURS=24   # how far back the very first poll looks
# LOOKBACK_MINUTES=30       # every poll re-checks this far back (catches posts a check missed)
# POLL_SECONDS=600          # loop interval
# APIFY_MAX_USD_PER_RUN=0.25
# POSTS_PER_PAGE=10         # max posts per page per poll
# DIGEST_HOURS_ET=7,15     # digest times, Eastern (sent by whichever poll runs first after each)
